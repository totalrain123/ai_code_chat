# 腾讯混元
TENCENT_API_KEY=your_tencent_api_key
TENCENT_API_SECRET=your_tencent_api_secret

# 阿里通义千问
ALIBABA_API_KEY=your_alibaba_api_key

# 百度文心一言
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key 

# 模型路由配置
# ENABLED_MODELS 留空表示启用所有已实现模型
ENABLED_MODELS=hunyuan,qianwen,wenxin
# DEFAULT_MODEL 需要在 ENABLED_MODELS 中，且相关 API Key 已配置
DEFAULT_MODEL=hunyuan